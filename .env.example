# Oracle69 AgentPay — local execution configuration (EXAMPLE ONLY).
# Copy to .env for local testnet runs. NEVER commit a real key.
# .env is git-ignored; this file contains placeholders only.
EXECUTOR_PRIVATE_KEY=0x<64-hex-chars-testnet-payer-key-never-commit>
# NOTE: no RPC override is read from the environment. The chain adapter
# (src/execution/chain.ts) only connects to the allowlisted Monad Testnet
# endpoints (testnet-rpc.monad.xyz, rpc-testnet.monadinfra.com); any other
# URL is refused at construction. There is deliberately no mainnet path.

# --- PayPal Sandbox (server-side only; never expose these to the browser) ---
# Mode is explicit: "sandbox" uses the real PayPal REST API, "mock" is a
# clearly-labelled local simulation with no network calls and no real money.
# If PAYPAL_MODE is omitted, sandbox is selected only when both credentials
# are present; otherwise the server starts in clearly-labelled mock mode.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=<your-paypal-sandbox-client-id>
PAYPAL_CLIENT_SECRET=<your-paypal-sandbox-client-secret>
PAYPAL_BASE_URL=https://api.sandbox.paypal.com
PAYPAL_MERCHANT_ID=<your-paypal-sandbox-merchant-id>
# Comma-separated allowlisted receiver emails / payer IDs.
PAYPAL_ALLOWED_RECEIVERS=merchant@example.com
# Hard ceiling is 1000 cents ($10.00); larger values are rejected by policy.
PAYPAL_MAX_MINOR=1000
PAYPAL_DB_PATH=./data/paypal.sqlite
# Operator authentication: when set, state-changing PayPal routes AND the
# audit trail require x-agentpay-operator-token. Leave empty only for a local
# demo. Production/public deployments refuse to start without a token.
PAYPAL_OPERATOR_TOKEN=
# Fail closed in public/production deployments. Set either flag to "true" to
# require PAYPAL_OPERATOR_TOKEN at startup even if NODE_ENV is not production.
PAYPAL_PUBLIC_DEPLOYMENT=false
PAYPAL_REQUIRE_OPERATOR_AUTH=false

# AI Provider Configuration (for natural-language payment interpretation)
# These variables are optional — the application gracefully degrades when
# AI is unavailable, falling back to the deterministic regex parser.
# Never commit actual API keys; keep them in .env only.
#
# Default provider: groq (OpenAI-compatible, verified live extraction)
# Alternative: gemini (native REST API)
# Retained but disabled by default: openai (API credits exhausted)
AI_PROVIDER=groq
AI_MODEL_NAME=openai/gpt-oss-20b
# AI_API_KEY is provider-dependent:
#   groq: <your-groq-api-key>
#   gemini: <your-gemini-api-key>
#   openai: sk-proj-... (currently disabled)
AI_API_KEY=<your-groq-api-key>
AI_BASE_URL=https://api.groq.com/openai/v1

